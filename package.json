{
  "name": "eule-mcp",
  "version": "0.3.0",
  "description": "MCP server for an office assistant - E-Mail/Calendar integration, tasks & resource planning",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "author": "metaneutrons",
  "repository": {
    "type": "git",
    "url": "https://github.com/metaneutrons/eule-mcp.git"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.7.1",
  "bin": {
    "eule-mcp": "./dist/cli/index.js"
  },
  "exports": {
    ".": {
      "import": "./dist/server/index.js"
    }
  },
  "files": [
    "dist",
    "config.example.yaml"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "serve": "node dist/server/index.js",
    "setup": "node dist/cli/index.js setup",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write 'src/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts'",
    "version:check": "node scripts/check-version.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "husky"
  },
  "keywords": [
    "mcp",
    "kiro",
    "office",
    "m365",
    "outlook",
    "gtd",
    "tasks",
    "calendar",
    "email"
  ],
  "dependencies": {
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "better-sqlite3": "^13.0.3",
    "fast-xml-parser": "^5.10.1",
    "imapflow": "^1.6.5",
    "js-yaml": "^5.2.1",
    "marked": "^18.0.7",
    "nodemailer": "^9.0.1",
    "open": "^11.0.0",
    "tsdav": "^2.3.1",
    "turndown": "^7.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.2",
    "@types/nodemailer": "^8.0.1",
    "@types/turndown": "^5.0.6",
    "eslint": "^10.8.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  }
}
